# Dataset manifests hash exact bytes; Windows checkouts must retain LF.
data/*.json text eol=lf

# Binary assets must never be line-ending converted (favicon / screenshots).
*.ico binary
*.png binary

# verify_bank 在历史里以 CRLF 入库（早于上面的规则）；单独豁免 EOL 转换：
# 字节保持零改动，也不会每次 git status 都因「clean 后与 index 不同」报假改动。
# 将来若要把库内统一成 LF，删掉这行后跑一次 git add --renormalize 即可。
data/verify_bank.json -text
